  m_Script: {fileID: 11500000, guid: 5990ec1f2c69c7d4abf8997bbdb091a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprites_list:
  - {fileID: 21300000, guid: 05a5afc661fd35e4abb6e2d4f8907e74, type: 3}
  - {fileID: 21300000, guid: 45365a46a3706d245918c33950290e7f, type: 3}
  - {fileID: 21300000, guid: 8dbd0aa33404959478bc8a8d28e7a627, type: 3}
  - {fileID: 21300000, guid: 3ca5c8fe92c474d4cbe3b78f2f22bf12, type: 3}
  image: {fileID: 1127570961383090817}
  textline:
  - "W, A, S, D \uD0A4\uB294 \uD50C\uB808\uC774\uC5B4 \uC774\uB3D9\uC744 \uB2F4\uB2F9\uD558\uBA70,
    \uAE30\uAE30 \uC0C1\uD638 \uC791\uC6A9\uC740 F\uD0A4, \uC74C\uC2DD \uC7AC\uB8CC
    \uB193\uAE30\uB294 E\uD0A4\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uADF8\uB7EC\uB098
    \uC7AC\uB8CC\uB97C \uC694\uB9AC\uD558\uAC70\uB098 \uC190\uB2D8\uC5D0\uAC8C \uC74C\uC2DD\uC744
    \uAC00\uC838\uB2E4 \uC904 \uB54C\uC5D0\uB294 E\uAC00 \uC544\uB2CC F\uD0A4\uB97C
    \uC0AC\uC6A9\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uD50C\uB808\uC774\uC5B4\uB294 \uC694\uB9AC\uB97C \uD558\uACE0 \uADF8 \uC74C\uC2DD\uC744
    \uC190\uB2D8\uC5D0\uAC8C \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC10\uC790\uD280\uAE40
    \uBC0F \uCF5C\uB77C\uB294 \uADF8\uB0E5 \uAE30\uACC4\uC5D0 \uAC00\uAE4C\uC774
    \uAC00\uC11C F\uD0A4\uB97C \uB20C\uB7EC \uC0C1\uD638\uC791\uC6A9\uC744 \uD558\uBA74
    \uB418\uBA70, \uD584\uBC84\uAC70\uC758 \uACBD\uC6B0, \uACE0\uAE30\uB97C \uC5BB\uC5B4\uC11C
    \uAD6C\uC6B4 \uB2E4\uC74C \uC870\uB9BD\uC744 \uD574\uC57C \uD569\uB2C8\uB2E4. "
  - "\uD55C \uB77C\uC6B4\uB4DC(4\uBD84)\uC774 \uB05D\uB098\uBA74 \uC815\uC0B0 UI\uAC00
    \uB098\uC624\uBA70, \uC815\uC0B0 UI\uC5D0\uC11C \uC0C1\uC810\uC5D0 \uB4E4\uC5B4\uAC00
    \uAE30\uACC4 \uBC0F \uC74C\uC2DD \uAC15\uD654\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB3C8\uC774 \uC5C6\uC73C\uBA74 \uAC15\uD654\uB97C \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. "
  - "\uC624\uB978\uCABD \uCEE8\uBCA0\uC774\uC5B4 \uBCA8\uD2B8\uC5D0\uC11C\uB294 VR\uAC00
    \uC804\uB2EC\uD574\uC900 \uACE0\uAE30\uB97C \uBC1B\uACE0, \uC67C\uCABD \uCEE8\uBCA0\uC774\uC5B4
    \uBCA8\uD2B8\uC5D0\uB294 \uC74C\uC2DD\uC744 \uB193\uC544 VR\uC5D0\uAC8C \uC804\uB2EC\uD574
    \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
  line: {fileID: 1995378780909729312}
